# Google Gemini API key (optional for offline mode, required for full Gemini LLM generation)
GOOGLE_API_KEY=your_gemini_api_key_here

# Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Server Settings
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_SIZE_MB=50

# RAG Hyperparameters
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
TOP_K_DENSE=8
TOP_K_LEXICAL=8
TOP_K_FINAL=5
USE_CHROMADB=false
